// Standalone K32 specialization: identical F16 multiply and F32 +0 publication.
#include <hlsl/dx/linalg.h>
using namespace dx::linalg;
ByteAddressBuffer Weights : register(t0);
StructuredBuffer<float> Input : register(t1);
RWStructuredBuffer<float> Output : register(u0);
cbuffer Shape : register(b0) { uint Rows, Columns, Inner, WeightTileStride; };
[numthreads(32,1,1)]
void Main(uint3 id : SV_DispatchThreadID) {
    if(id.x >= Rows) return;
    vector<float16_t,32> a;
    a[0] = float16_t(Input[id.x*32+0]);
    a[1] = float16_t(Input[id.x*32+1]);
    a[2] = float16_t(Input[id.x*32+2]);
    a[3] = float16_t(Input[id.x*32+3]);
    a[4] = float16_t(Input[id.x*32+4]);
    a[5] = float16_t(Input[id.x*32+5]);
    a[6] = float16_t(Input[id.x*32+6]);
    a[7] = float16_t(Input[id.x*32+7]);
    a[8] = float16_t(Input[id.x*32+8]);
    a[9] = float16_t(Input[id.x*32+9]);
    a[10] = float16_t(Input[id.x*32+10]);
    a[11] = float16_t(Input[id.x*32+11]);
    a[12] = float16_t(Input[id.x*32+12]);
    a[13] = float16_t(Input[id.x*32+13]);
    a[14] = float16_t(Input[id.x*32+14]);
    a[15] = float16_t(Input[id.x*32+15]);
    a[16] = float16_t(Input[id.x*32+16]);
    a[17] = float16_t(Input[id.x*32+17]);
    a[18] = float16_t(Input[id.x*32+18]);
    a[19] = float16_t(Input[id.x*32+19]);
    a[20] = float16_t(Input[id.x*32+20]);
    a[21] = float16_t(Input[id.x*32+21]);
    a[22] = float16_t(Input[id.x*32+22]);
    a[23] = float16_t(Input[id.x*32+23]);
    a[24] = float16_t(Input[id.x*32+24]);
    a[25] = float16_t(Input[id.x*32+25]);
    a[26] = float16_t(Input[id.x*32+26]);
    a[27] = float16_t(Input[id.x*32+27]);
    a[28] = float16_t(Input[id.x*32+28]);
    a[29] = float16_t(Input[id.x*32+29]);
    a[30] = float16_t(Input[id.x*32+30]);
    a[31] = float16_t(Input[id.x*32+31]);
    using MatrixTy = Matrix<ComponentType::F16,32,32,MatrixUse::A,MatrixScope::Thread>;
    MatrixTy matrix = MatrixTy::Load<MatrixLayout::MulOptimal>(Weights,id.y*WeightTileStride,0);
    vector<float16_t,32> result = Multiply<float16_t>(matrix,a);
    Output[id.x*Columns+id.y*32+0] = 0.0f + float(result[0]);
    Output[id.x*Columns+id.y*32+1] = 0.0f + float(result[1]);
    Output[id.x*Columns+id.y*32+2] = 0.0f + float(result[2]);
    Output[id.x*Columns+id.y*32+3] = 0.0f + float(result[3]);
    Output[id.x*Columns+id.y*32+4] = 0.0f + float(result[4]);
    Output[id.x*Columns+id.y*32+5] = 0.0f + float(result[5]);
    Output[id.x*Columns+id.y*32+6] = 0.0f + float(result[6]);
    Output[id.x*Columns+id.y*32+7] = 0.0f + float(result[7]);
    Output[id.x*Columns+id.y*32+8] = 0.0f + float(result[8]);
    Output[id.x*Columns+id.y*32+9] = 0.0f + float(result[9]);
    Output[id.x*Columns+id.y*32+10] = 0.0f + float(result[10]);
    Output[id.x*Columns+id.y*32+11] = 0.0f + float(result[11]);
    Output[id.x*Columns+id.y*32+12] = 0.0f + float(result[12]);
    Output[id.x*Columns+id.y*32+13] = 0.0f + float(result[13]);
    Output[id.x*Columns+id.y*32+14] = 0.0f + float(result[14]);
    Output[id.x*Columns+id.y*32+15] = 0.0f + float(result[15]);
    Output[id.x*Columns+id.y*32+16] = 0.0f + float(result[16]);
    Output[id.x*Columns+id.y*32+17] = 0.0f + float(result[17]);
    Output[id.x*Columns+id.y*32+18] = 0.0f + float(result[18]);
    Output[id.x*Columns+id.y*32+19] = 0.0f + float(result[19]);
    Output[id.x*Columns+id.y*32+20] = 0.0f + float(result[20]);
    Output[id.x*Columns+id.y*32+21] = 0.0f + float(result[21]);
    Output[id.x*Columns+id.y*32+22] = 0.0f + float(result[22]);
    Output[id.x*Columns+id.y*32+23] = 0.0f + float(result[23]);
    Output[id.x*Columns+id.y*32+24] = 0.0f + float(result[24]);
    Output[id.x*Columns+id.y*32+25] = 0.0f + float(result[25]);
    Output[id.x*Columns+id.y*32+26] = 0.0f + float(result[26]);
    Output[id.x*Columns+id.y*32+27] = 0.0f + float(result[27]);
    Output[id.x*Columns+id.y*32+28] = 0.0f + float(result[28]);
    Output[id.x*Columns+id.y*32+29] = 0.0f + float(result[29]);
    Output[id.x*Columns+id.y*32+30] = 0.0f + float(result[30]);
    Output[id.x*Columns+id.y*32+31] = 0.0f + float(result[31]);
}

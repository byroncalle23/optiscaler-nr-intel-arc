diff --git a/OptiScaler/experimental/NativeNrControl.h b/OptiScaler/experimental/NativeNrControl.h
new file mode 100644
index 0000000..23ee2bb
--- /dev/null
+++ b/OptiScaler/experimental/NativeNrControl.h
@@ -0,0 +1,64 @@
+#pragma once
+#include <atomic>
+#include <imgui/imgui.h>
+#include "NativeNrModes.h"
+
+// Request only: the render callback owns initialization and GPU resources.
+// -1 is an unread startup setting. Menu changes never persist to the INI.
+namespace NativeNrControl {
+inline std::atomic<int> requested{-1};
+inline std::atomic<int> progress{0}; // 0 idle, 1 preparing, 2 recording, 3 failed
+inline std::atomic<bool> temporalRequested{false};
+inline std::atomic<bool> temporalApplied{false};
+inline std::atomic<int> temporalProgress{0}; // 0 missing inputs, 1 preparing, 2 captured, 3 unsupported
+inline void Startup(bool enabled){int unset=-1;requested.compare_exchange_strong(unset,enabled?1:0);}
+inline bool Enabled(){return requested.load(std::memory_order_acquire)==1;}
+inline void Set(bool enabled){requested.store(enabled?1:0,std::memory_order_release);}
+}
+
+bool NativeNrIsEnabled();
+void NativeNrSetEnabled(bool enabled);
+
+// Same widget in the game and in the headless ImGui interaction test.
+inline bool DrawNativeNrCheckbox(){
+    ImGui::Separator();
+    bool enabled=NativeNrIsEnabled();
+    if(ImGui::Checkbox("Reconstruccion neuronal experimental",&enabled))NativeNrSetEnabled(enabled);
+    return enabled;
+}
+inline void RenderNativeNrControl(){
+    bool enabled=DrawNativeNrCheckbox();
+#ifdef NR_GAME_MODES
+    int selected=NativeNrModes::requested.load();
+    if(ImGui::BeginCombo("Modo neuronal",NativeNrModes::modes[selected].label)){
+        for(int i=0;i<5;++i)if(ImGui::Selectable(NativeNrModes::modes[i].label,selected==i))NativeNrModes::Set(i);
+        ImGui::EndCombo();
+    }
+    if(enabled&&NativeNrModes::failure.load()==1)ImGui::TextWrapped("VRAM disponible insuficiente para este modo. Elige uno menor o reduce el uso de memoria del juego.");
+    else if(enabled&&NativeNrModes::failure.load()==2)ImGui::TextWrapped("Cambio pendiente: la grabacion anterior no termino. Elige otro modo para reintentar.");
+    else if(enabled&&NativeNrModes::active.load()!=NativeNrModes::requested.load()&&NativeNrModes::failure.load()==0)ImGui::TextWrapped("Preparando el modo elegido; el historial se reiniciara.");
+#endif
+    if(!enabled)ImGui::TextUnformatted("NR desactivado. Puedes activarlo durante la partida.");
+    else if(NativeNrControl::progress.load()==3)ImGui::TextWrapped("NR encontro un error. Consulta OptiScaler.log.");
+    else if(NativeNrControl::progress.load()==2)ImGui::TextUnformatted("NR: pase enviado en este Present.");
+    else ImGui::TextUnformatted("NR solicitado: preparando el modelo cuando haya una salida compatible.");
+    if(enabled&&NativeNrControl::temporalRequested.load()){
+        if(NativeNrControl::temporalApplied.load())ImGui::TextUnformatted("Temporal aplicado al pase NR.");
+        else if(NativeNrControl::temporalProgress.load()==2)ImGui::TextUnformatted("Temporal: movimiento y profundidad recibidos.");
+        else if(NativeNrControl::temporalProgress.load()==1)ImGui::TextUnformatted("Temporal: preparando historial; NR conserva la ruta anterior.");
+        else ImGui::TextWrapped("Temporal no aplicado: NR usa la ruta anterior. Consulta OptiScaler.log.");
+    }
+#ifdef NR_GAME_GLOBAL_B1
+#ifdef NR_GAME_MODES
+    ImGui::TextWrapped("Un pase sincrono, temporal y filtro de bordes. El modo elegido dura solo esta partida.");
+#elif defined(NR_GAME_COMPACT320)
+    ImGui::TextWrapped("PRUEBA compacta: 320x180, un pase sincrono, temporal y EdgeGuidedResidual sobre SDR nativo.");
+#elif defined(NR_GAME_COMPACT512)
+    ImGui::TextWrapped("PRUEBA compacta: 512x288, un pase sincrono y EdgeGuidedResidual sobre SDR nativo.");
+#else
+    ImGui::TextWrapped("Global B1: 640x360, un pase y residual sobre SDR nativo. El cambio dura solo esta partida.");
+#endif
+#else
+    ImGui::TextWrapped("El modo detalle es muy lento. El cambio dura solo esta partida.");
+#endif
+}
diff --git a/OptiScaler/experimental/NativeNrHook.h b/OptiScaler/experimental/NativeNrHook.h
new file mode 100644
index 0000000..612706a
--- /dev/null
+++ b/OptiScaler/experimental/NativeNrHook.h
@@ -0,0 +1,101 @@
+#pragma once
+#include <d3d12.h>
+#include <nvsdk_ngx_params.h>
+#include <atomic>
+#include <memory>
+#include <mutex>
+#include <map>
+#include <stdexcept>
+#include "NativeNrLifecycle.h"
+
+// Experimental post-upscale callback. Registration/initialization must finish
+// outside Evaluate; the immutable binding and GPU objects live through the fence.
+namespace NativeNrHook {
+enum class Result { Skipped, Recorded, Failed };
+struct Binding {
+    unsigned handleId,width,height;
+    DXGI_FORMAT format;
+    ID3D12Resource* output;
+    void* user;
+    bool (*record)(void*,ID3D12GraphicsCommandList*,ID3D12Resource*,D3D12_RESOURCE_STATES);
+    std::shared_ptr<void> owner;
+    bool (*ready)(void*)=nullptr;
+    bool allowCompatibleRotation=false;
+};
+inline std::atomic<const Binding*> active{nullptr};
+inline std::mutex bindingsMutex;
+inline std::map<unsigned,std::shared_ptr<const Binding>> bindings;
+inline void Register(const Binding* binding){active.store(binding,std::memory_order_release);}
+inline void RegisterOwned(std::shared_ptr<const Binding> binding){
+    if(!binding)return;std::lock_guard<std::mutex> lock(bindingsMutex);
+    if(bindings.count(binding->handleId))throw std::runtime_error("Duplicate owned NR binding");
+    bindings.emplace(binding->handleId,std::move(binding));
+}
+inline void Unregister(unsigned handle){std::lock_guard<std::mutex> lock(bindingsMutex);bindings.erase(handle);}
+inline ID3D12Resource* GetOutput(const NVSDK_NGX_Parameter* params){
+    if(!params)return nullptr;ID3D12Resource* output=nullptr;
+    if(params->Get(NVSDK_NGX_Parameter_Output,&output)==NVSDK_NGX_Result_Success)return output;
+    void* pointer=nullptr;if(params->Get(NVSDK_NGX_Parameter_Output,&pointer)!=NVSDK_NGX_Result_Success)return nullptr;
+    return static_cast<ID3D12Resource*>(pointer);
+}
+inline ID3D12Resource* GetResource(const NVSDK_NGX_Parameter* params,const char* key){
+    ID3D12Resource* resource=nullptr;if(params->Get(key,&resource)==NVSDK_NGX_Result_Success)return resource;
+    void* pointer=nullptr;if(params->Get(key,&pointer)!=NVSDK_NGX_Result_Success)return nullptr;return static_cast<ID3D12Resource*>(pointer);
+}
+inline NativeNrTemporal::FrameInput ReadFrameInputs(unsigned handle,UINT64 frame,const NVSDK_NGX_Parameter* params,unsigned flags){
+    NativeNrTemporal::FrameInput f{};f.handle=handle;f.featureFrame=frame;if(!params)return f;
+    f.colour.resource=GetResource(params,NVSDK_NGX_Parameter_Color);f.depth.resource=GetResource(params,NVSDK_NGX_Parameter_Depth);
+    f.motion.resource=GetResource(params,NVSDK_NGX_Parameter_MotionVectors);f.output.resource=GetOutput(params);
+    params->Get(NVSDK_NGX_Parameter_DLSS_Render_Subrect_Dimensions_Width,&f.renderWidth);
+    params->Get(NVSDK_NGX_Parameter_DLSS_Render_Subrect_Dimensions_Height,&f.renderHeight);
+    params->Get("FSR.upscaleSize.width",&f.displayWidth);params->Get("FSR.upscaleSize.height",&f.displayHeight);
+    f.scalesKnown=params->Get(NVSDK_NGX_Parameter_MV_Scale_X,&f.motionScaleX)==NVSDK_NGX_Result_Success;
+    f.scalesKnown=(params->Get(NVSDK_NGX_Parameter_MV_Scale_Y,&f.motionScaleY)==NVSDK_NGX_Result_Success)&&f.scalesKnown;
+    f.jitterKnown=params->Get(NVSDK_NGX_Parameter_Jitter_Offset_X,&f.jitterX)==NVSDK_NGX_Result_Success;
+    f.jitterKnown=(params->Get(NVSDK_NGX_Parameter_Jitter_Offset_Y,&f.jitterY)==NVSDK_NGX_Result_Success)&&f.jitterKnown;
+    unsigned reset=0;params->Get(NVSDK_NGX_Parameter_Reset,&reset);f.reset=reset!=0;
+    f.cameraRangeKnown=params->Get("FSR.cameraNear",&f.cameraNear)==NVSDK_NGX_Result_Success;
+    f.cameraRangeKnown=(params->Get("FSR.cameraFar",&f.cameraFar)==NVSDK_NGX_Result_Success)&&f.cameraRangeKnown&&std::isfinite(f.cameraNear)&&std::isfinite(f.cameraFar)&&f.cameraNear>0&&f.cameraFar>f.cameraNear;
+    // Only explicit FFX-dispatch states are accepted here, not backend guesses.
+    auto state=[&](const char* known,const char* key,NativeNrTemporal::ResourceView& view){unsigned valid=0,value=0;
+        if(params->Get(known,&valid)==NVSDK_NGX_Result_Success&&valid&&params->Get(key,&value)==NVSDK_NGX_Result_Success){view.state=static_cast<D3D12_RESOURCE_STATES>(value);view.stateKnown=true;}};
+    state("NR.MotionStateKnown","NR.MotionState",f.motion);state("NR.DepthStateKnown","NR.DepthState",f.depth);
+    state("NR.ReactiveStateKnown","NR.ReactiveState",f.reactive);
+    if(f.reactive.stateKnown)f.reactive.resource=GetResource(params,"FSR.reactive");
+    f.lowResolutionMotion=(flags&NVSDK_NGX_DLSS_Feature_Flags_MVLowRes)!=0;
+    f.jitteredMotion=(flags&NVSDK_NGX_DLSS_Feature_Flags_MVJittered)!=0;
+    f.invertedDepth=(flags&NVSDK_NGX_DLSS_Feature_Flags_DepthInverted)!=0;
+    // Declared FFX API convention, matching the bundled FSR3 backend's normalization.
+    // Live quality still needs validation; unknown APIs cannot enable this path.
+    unsigned ffxContract=0;params->Get("NR.FfxMotionContract",&ffxContract);
+    if(ffxContract==1){f.motionConventionVerified=true;f.motionReferenceWidth=f.lowResolutionMotion?f.renderWidth:f.displayWidth;f.motionReferenceHeight=f.lowResolutionMotion?f.renderHeight:f.displayHeight;}
+    return f;
+}
+inline Result Evaluate(unsigned handle,ID3D12GraphicsCommandList* list,const NVSDK_NGX_Parameter* params,
+                       bool hdr,bool knownState,D3D12_RESOURCE_STATES outputState){
+    std::shared_ptr<const Binding> retained;
+    {std::lock_guard<std::mutex> lock(bindingsMutex);auto found=bindings.find(handle);if(found!=bindings.end())retained=found->second;}
+    const Binding* binding=retained?retained.get():active.load(std::memory_order_acquire);
+    if(hdr||!knownState)return Result::Skipped;
+    if(!binding||handle!=binding->handleId){
+        if(list&&list->GetType()==D3D12_COMMAND_LIST_TYPE_DIRECT)if(auto output=GetOutput(params))NativeNrLifecycle::Observe(handle,output);
+        return Result::Skipped;
+    }
+    if(!list||!params||!binding->record||!binding->output)return Result::Failed;
+    ID3D12Resource* output=GetOutput(params);
+    if(output!=binding->output&&!binding->allowCompatibleRotation){
+        if(output&&list->GetType()==D3D12_COMMAND_LIST_TYPE_DIRECT)NativeNrLifecycle::Observe(handle,output);
+        return Result::Skipped; // Worker retires/rebuilds; never change descriptors on an outstanding list.
+    }
+    if(binding->ready&&!binding->ready(binding->user))return Result::Skipped;
+    auto desc=output->GetDesc();
+    if(desc.Dimension!=D3D12_RESOURCE_DIMENSION_TEXTURE2D||desc.Width!=binding->width||desc.Height!=binding->height||desc.Format!=binding->format||desc.MipLevels!=1||desc.DepthOrArraySize!=1||desc.SampleDesc.Count!=1){
+        if(binding->allowCompatibleRotation&&list->GetType()==D3D12_COMMAND_LIST_TYPE_DIRECT)NativeNrLifecycle::Observe(handle,output);
+        return Result::Skipped;
+    }
+    if(!binding->record(binding->user,list,output,outputState))return Result::Failed;
+    // A failed observer must retain the registered session: GPU commands have
+    // already been recorded. Do not release it or replay to recover here.
+    return NativeNrLifecycle::Recorded(handle,list)?Result::Recorded:Result::Failed;
+}
+}
diff --git a/OptiScaler/experimental/NativeNrLifecycle.h b/OptiScaler/experimental/NativeNrLifecycle.h
new file mode 100644
index 0000000..6263a47
--- /dev/null
+++ b/OptiScaler/experimental/NativeNrLifecycle.h
@@ -0,0 +1,61 @@
+#pragma once
+#include <d3d12.h>
+#include <memory>
+#include <mutex>
+#include "NativeNrFrameInput.h"
+
+// Disabled experimental boundary. Provider owns its controller and serializes
+// record/submit/reset/retire; callbacks must retain GPU objects on any failure.
+namespace NativeNrLifecycle {
+using Forward = void (*)(void*);
+struct Provider {
+    std::shared_ptr<void> owner;
+    void* user=nullptr;
+    bool (*execute)(void*,ID3D12CommandQueue*,UINT,ID3D12CommandList* const*,Forward,void*)=nullptr;
+    bool (*recorded)(void*,unsigned,ID3D12GraphicsCommandList*)=nullptr;
+    void (*reset)(void*,ID3D12GraphicsCommandList*)=nullptr;
+    void (*retire)(void*,unsigned)=nullptr;
+    void (*shutdown)(void*)=nullptr; // Request retirement; not proof of GPU completion.
+    void (*observe)(void*,unsigned,ID3D12Resource*)=nullptr; // Metadata only; no preparation here.
+    // Optional temporal capture before the upscaler consumes/reuses engine inputs.
+    // An absent/failed temporal observer must never fail the game's upscaler.
+    bool (*frameInputs)(void*,ID3D12GraphicsCommandList*,const NativeNrTemporal::FrameInput&)=nullptr;
+};
+inline std::mutex mutex;
+inline std::shared_ptr<const Provider> provider;
+inline void Register(std::shared_ptr<const Provider> value){std::lock_guard<std::mutex> lock(mutex);provider=std::move(value);}
+inline std::shared_ptr<const Provider> Snapshot(){std::lock_guard<std::mutex> lock(mutex);return provider;}
+// Forward the game's call exactly once even when the provider fails before or
+// after Execute. Never replay the list to recover from a missing NR marker.
+inline bool Execute(ID3D12CommandQueue* queue,UINT count,ID3D12CommandList* const* lists,Forward original,void* user) noexcept {
+    if(!original)return false;
+    struct Call {Forward original;void* user;bool called=false,duplicate=false;} call{original,user};
+    auto once=[](void* pointer){auto& value=*static_cast<Call*>(pointer);
+        if(value.called){value.duplicate=true;return;}value.called=true;value.original(value.user);};
+    bool success=true;
+    try{auto value=Snapshot();if(value&&value->execute)success=value->execute(value->user,queue,count,lists,once,&call);}
+    catch(...){success=false;}
+    if(!call.called){try{once(&call);}catch(...){success=false;}}
+    return success&&!call.duplicate;
+}
+inline bool Reset(ID3D12GraphicsCommandList* list,HRESULT result) noexcept {
+    if(FAILED(result))return true;
+    try{auto value=Snapshot();if(value&&value->reset)value->reset(value->user,list);return true;}catch(...){return false;}
+}
+inline bool Recorded(unsigned handle,ID3D12GraphicsCommandList* list) noexcept {
+    try{auto value=Snapshot();return !value||!value->recorded||value->recorded(value->user,handle,list);}catch(...){return false;}
+}
+inline bool Retire(unsigned handle) noexcept {
+    try{auto value=Snapshot();if(value&&value->retire)value->retire(value->user,handle);return true;}catch(...){return false;}
+}
+inline bool Shutdown() noexcept {
+    try{auto value=Snapshot();if(value&&value->shutdown)value->shutdown(value->user);return true;}catch(...){return false;}
+}
+inline bool Observe(unsigned handle,ID3D12Resource* output) noexcept {
+    try{auto value=Snapshot();if(value&&value->observe)value->observe(value->user,handle,output);return true;}catch(...){return false;}
+}
+inline bool FrameInputs(ID3D12GraphicsCommandList* list,const NativeNrTemporal::FrameInput& input) noexcept {
+    if(!list||list->GetType()!=D3D12_COMMAND_LIST_TYPE_DIRECT)return false;
+    try{auto value=Snapshot();return value&&value->frameInputs&&value->frameInputs(value->user,list,input);}catch(...){return false;}
+}
+}
diff --git a/OptiScaler/experimental/NativeNrQueueHook.h b/OptiScaler/experimental/NativeNrQueueHook.h
new file mode 100644
index 0000000..d63097e
--- /dev/null
+++ b/OptiScaler/experimental/NativeNrQueueHook.h
@@ -0,0 +1,39 @@
+#pragma once
+#include "NativeNrLifecycle.h"
+#include <detours/detours.h>
+#include <atomic>
+
+// Installation/removal require quiescent caller threads. This experiment only
+// covers the captured DIRECT queue implementation; do not enable NR on another
+// implementation or queue without installing and validating its observer.
+class NativeNrQueueHook {
+    using ExecuteFn=void (STDMETHODCALLTYPE*)(ID3D12CommandQueue*,UINT,ID3D12CommandList* const*);
+    inline static ExecuteFn original=nullptr;
+    inline static PVOID target=nullptr;
+    inline static std::mutex mutex;
+    inline static std::atomic<UINT64> failures{0};
+    static void STDMETHODCALLTYPE Execute(ID3D12CommandQueue* queue,UINT count,ID3D12CommandList* const* lists){
+        struct Call {ID3D12CommandQueue* queue;UINT count;ID3D12CommandList* const* lists;} call{queue,count,lists};
+        if(!NativeNrLifecycle::Execute(queue,count,lists,[](void* user){auto& args=*static_cast<Call*>(user);original(args.queue,args.count,args.lists);},&call))++failures;
+    }
+public:
+    static bool Install(ID3D12CommandQueue* queue){
+        if(!queue||queue->GetDesc().Type!=D3D12_COMMAND_LIST_TYPE_DIRECT)return false;
+        std::lock_guard<std::mutex> lock(mutex);auto address=(*(PVOID**)queue)[10];
+        if(original)return address==target;
+        original=reinterpret_cast<ExecuteFn>(address);
+        if(DetourTransactionBegin()!=NO_ERROR){original=nullptr;return false;}
+        if(DetourUpdateThread(GetCurrentThread())!=NO_ERROR||DetourAttach(&(PVOID&)original,Execute)!=NO_ERROR){
+            DetourTransactionAbort();original=nullptr;return false;}
+        if(DetourTransactionCommit()!=NO_ERROR){original=nullptr;return false;}
+        target=address;return true;
+    }
+    static bool Remove(){
+        std::lock_guard<std::mutex> lock(mutex);if(!original)return true;
+        if(DetourTransactionBegin()!=NO_ERROR)return false;
+        if(DetourUpdateThread(GetCurrentThread())!=NO_ERROR||DetourDetach(&(PVOID&)original,Execute)!=NO_ERROR){DetourTransactionAbort();return false;}
+        if(DetourTransactionCommit()!=NO_ERROR)return false;
+        original=nullptr;target=nullptr;return true;
+    }
+    static UINT64 FailureCount(){return failures.load();}
+};
